# Launchpad server settings. Copied to .env by install.sh; real environment variables override this file.

# The OAuth app registered on MonkeForge (Settings -> Developer -> Applications). The secret never leaves this server.
LAUNCHPAD_CLIENT_ID=5fadc971d6867d50fcbd0dd6
LAUNCHPAD_CLIENT_SECRET=

# Where root (/) redirects.
HOMEPAGE_URL=https://monkeforge.org/software/launchpad

# Lets scripts/release.cs upload releases. Use a long random value (at least 32 characters), e.g. `openssl rand -hex 32`.
PUBLISH_TOKEN=

# The release key's public half (printed by `dotnet run scripts/release.cs -- keygen`). When set, uploads and release
# folders that aren't signed with it are refused. Launchpad checks the signature itself either way.
RELEASE_PUBLIC_KEY=

# Behind Cloudflare, rate limits use CF-Connecting-IP instead of the proxy's address.
TRUST_CLOUDFLARE=true

# Listen address. Put a reverse proxy (Caddy, nginx, Cloudflare Tunnel) in front for HTTPS.
ASPNETCORE_URLS=http://127.0.0.1:5080

# FORGE_URL=https://monkeforge.org
# DATA_DIR=/opt/launchpad-server/data
# MAX_UPLOAD_MB=1024
